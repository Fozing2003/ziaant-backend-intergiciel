[build]
builder = "dockerfile"


# EUREKA SERVER

[services.eureka-server]
source = "eureka-server"
dockerfile = "eureka-server/Dockerfile"

[services.eureka-server.deploy]
startCommand = "java -jar app.jar"
healthcheckPath = "/actuator/health"
healthcheckTimeout = 60


